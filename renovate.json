{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>universalphotos-app/.github:renovate-config"],
  "packageRules": [
    {
      "matchFileNames": [
        "machine-learning/**"
      ],
      "groupName": "machine-learning",
      "rangeStrategy": "in-range-only"
    },
    {
      "matchFileNames": [
        "machine-learning/**"
      ],
      "matchPackageNames": [
        "onnxruntime*",
        "rknn-toolkit-lite2"
      ],
      "groupName": null
    },
    {
      "matchFileNames": [
        "mobile/**"
      ],
      "groupName": "mobile",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "addLabels": [
        "📱mobile"
      ]
    },
    {
      "matchPackageNames": ["/postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["/base-server-*"],
      "maxMajorIncrement": 0
    },
    {
      "matchPackageNames": ["ruby"],
      "groupName": "ruby",
      "matchCurrentVersion": "< 3.4",
      "enabled": false
    }
  ],
  "ignorePaths": [
    "mobile/ios",
    "mobile/android"
  ],
  "ignoreDeps": [
    "http",
    "intl"
  ]
}
